{
  "name": "proofmark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "smoke:production": "node scripts/smoke-production.mjs",
    "sbom": "npm exec --yes --package=@cyclonedx/cyclonedx-npm@4.0.1 -- cyclonedx-npm --output-file sbom.cdx.json --output-format JSON --spec-version 1.6 --omit dev"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1101.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "postcss": "^8.5.25",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
